# Probe captures come from real sessions. Even redacted at ingest they hold model
# names, tool names and timings, and a --StoreRawValues or VS Code file-exporter
# capture can hold prompts, paths and account identity. Never commit them.
# A reviewed schema snapshot can be copied to docs/schemas/captured/ instead.
probe/captures/

# Local monitoring stack: the Grafana login written by `infra/stack.ps1 init`,
# any other env file, and verification/selftest output (it quotes stored values).
infra/.env
infra/.env.*
!infra/.env.example
infra/out/

__pycache__/
*.py[cod]
